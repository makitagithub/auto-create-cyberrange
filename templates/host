---
{% for host in hosts%}
- name: Configuring routing tables on {{ host.host_name }}
  hosts: {{ host.host_name }}
  tasks:

  - name: Install net-tools
    become: yes
    command: apt-get install net-tools

  - name: Change default gateway
    become: yes
    command: route add default gw {{ host.router_ip }} eth1

{% endfor %}
...
