---
# Basic configuration of all defined devices

- name: Including variables
  hosts: all
  tasks:

  - name: Including common variables
    include_vars:
      file: config.yml
      name: config

- name: Configuring routers
  hosts: routers
  become: yes
  tasks:
  - name: include role
    include_role:
      name: routers
    when: config.routers

- name: Configuring devices separately
  hosts: all
  become: yes
  tasks:
  - name: include role
    include_role:
      name: "{{ inventory_hostname }}"
...
